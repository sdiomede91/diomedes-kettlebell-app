{
  "expo": {
    "name": "Diomedes",
    "slug": "diomedes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "diomedes",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.diomedes.app",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F1EBDD",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.diomedes.app",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F1EBDD",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#0E1522",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-video",
      "expo-audio",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#1B2A44"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "813c5f40-e699-447d-8b9c-086556725b70"
      }
    },
    "owner": "sdiomede91",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/813c5f40-e699-447d-8b9c-086556725b70"
    }
  }
}
